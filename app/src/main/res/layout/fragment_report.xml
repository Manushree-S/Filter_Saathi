<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Card 1: Report Problem Form -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReportForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card_light"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/surface_card_stroke_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 5dp Tricolour top bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/topbar_saffron" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/topbar_blue" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/topbar_green" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/ui_rep_title"
                                android:textColor="@color/text_primary_light"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_sample_tag"
                                android:text="@string/ui_sample"
                                android:textColor="@color/alert_amber_text"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Error Message Banner -->
                        <TextView
                            android:id="@+id/tvReportError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@color/alert_red_bg"
                            android:padding="12dp"
                            android:textColor="@color/alert_red_text"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <!-- Problem Type Dropdown -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilProblemType"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="@string/ui_rep_type">

                            <AutoCompleteTextView
                                android:id="@+id/actvProblemType"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:minHeight="48dp"
                                android:textColor="@color/text_primary_light"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Village or Gram Panchayat Input -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilVillage"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/ui_village">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etVillage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords"
                                android:minHeight="48dp"
                                android:textColor="@color/text_primary_light"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Details (optional) Input -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilDetails"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/ui_rep_desc">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDetails"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine"
                                android:minLines="2"
                                android:textColor="@color/text_primary_light"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Simulated Add Photo Toggle -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPhotoLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/ui_rep_photo"
                                android:textColor="@color/text_primary_light"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchPhoto"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:contentDescription="@string/ui_rep_photo" />
                        </LinearLayout>

                        <!-- Send Report Button -->
                        <TextView
                            android:id="@+id/btnSendReport"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="20dp"
                            android:background="@drawable/bg_btn_saffron"
                            android:gravity="center"
                            android:text="@string/ui_rep_btn"
                            android:textColor="@color/hero_btn_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/ui_rep_btn" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Report Result Card (Shown after report is submitted) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReportResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_card_light"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/surface_card_stroke_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Top Banner: Green "Report sent. Ticket no. ..." -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/alert_green_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_check"
                            android:contentDescription="@null"
                            app:tint="@color/alert_green_text" />

                        <TextView
                            android:id="@+id/tvResultBanner"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:textColor="@color/alert_green_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Ticket Title & Location -->
                        <TextView
                            android:id="@+id/tvTicketNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/secondary_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTicketVillage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary_light"
                            android:textSize="14sp" />

                        <!-- Received -> In review -> Fixed Stepper Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Stage 1: Received (Completed) -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/bg_stage_done"
                                    android:contentDescription="@string/ui_rs1" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/ui_rs1"
                                    android:textColor="@color/text_primary_light"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="2dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="8dp"
                                android:layout_marginBottom="10dp"
                                android:background="@color/status_success" />

                            <!-- Stage 2: In review (Active / Pulsing) -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/ivInReviewIndicator"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/bg_stage_current"
                                    android:contentDescription="@string/ui_rs2" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/ui_rs2"
                                    android:textColor="@color/accent_saffron"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="2dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="8dp"
                                android:layout_marginBottom="10dp"
                                android:background="@color/divider_light" />

                            <!-- Stage 3: Fixed (Pending) -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/bg_stage_pending"
                                    android:contentDescription="@string/ui_rs3" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/ui_rs3"
                                    android:textColor="@color/text_secondary_light"
                                    android:textSize="12sp" />
                            </LinearLayout>

                        </LinearLayout>

                        <!-- Button Send Another -->
                        <TextView
                            android:id="@+id/btnSendAnother"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="28dp"
                            android:background="@drawable/bg_lang_toggle_container"
                            android:gravity="center"
                            android:text="@string/ui_rep_new"
                            android:textColor="@color/text_primary_light"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/ui_rep_new" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
