<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWelcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/welcome_card_bg"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/surface_card_stroke_light"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="440dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 5dp top bar in saffron, blue and green -->
                <LinearLayout
                    android:id="@+id/topBar"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/topbar_saffron" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/topbar_blue" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/topbar_green" />
                </LinearLayout>

                <!-- Card Body -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="28dp">

                    <!-- Logo: gradient circle with drop and check -->
                    <ImageView
                        android:id="@+id/ivLogo"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:contentDescription="@string/ui_welcome_brand"
                        android:src="@drawable/ic_welcome_logo" />

                    <!-- Brand: "ಫಿಲ್ಟರ್ ಸಾಥಿ · FilterSaathi" -->
                    <TextView
                        android:id="@+id/tvBrand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/ui_welcome_brand"
                        android:textColor="@color/text_primary_light"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- Tagline: "ಪ್ರತಿ ಹನಿ, ಸುರಕ್ಷಿತ · Every drop, verified." -->
                    <TextView
                        android:id="@+id/tvTagline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/ui_welcome_tagline"
                        android:textColor="@color/text_secondary_light"
                        android:textSize="14sp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="24dp"
                        android:background="@color/divider_light" />

                    <!-- Language Selection Prompt: "ಭಾಷೆ ಆಯ್ಕೆಮಾಡಿ · Choose language" -->
                    <TextView
                        android:id="@+id/tvChooseLanguage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:gravity="center"
                        android:text="@string/ui_welcome_choose_lang"
                        android:textColor="@color/text_primary_light"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Button 1: ಕನ್ನಡ (saffron #B45309, min 64dp high) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKannada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:minHeight="64dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/ui_lang_kn"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/saffron_dark"
                        app:cornerRadius="14dp" />

                    <!-- Button 2: English (navy #0F2A5C, min 64dp high) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnglish"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/ui_lang_en"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary_navy"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
