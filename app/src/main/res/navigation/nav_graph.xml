<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_welcome">

    <fragment
        android:id="@+id/navigation_welcome"
        android:name="org.filtersaathi.app.ui.welcome.WelcomeFragment"
        android:label="@string/ui_welcome_brand">
        <action
            android:id="@+id/action_welcome_to_home"
            app:destination="@id/navigation_home"
            app:popUpTo="@id/navigation_welcome"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_home"
        android:name="org.filtersaathi.app.ui.home.HomeFragment"
        android:label="@string/ui_nav_home" />

    <fragment
        android:id="@+id/navigation_register"
        android:name="org.filtersaathi.app.ui.auth.RegisterFragment"
        android:label="@string/ui_reg_title">
        <action
            android:id="@+id/action_register_to_otp"
            app:destination="@id/navigation_otp" />
    </fragment>

    <fragment
        android:id="@+id/navigation_otp"
        android:name="org.filtersaathi.app.ui.auth.OtpFragment"
        android:label="@string/ui_otp_title">
        <action
            android:id="@+id/action_otp_to_book"
            app:destination="@id/navigation_book"
            app:popUpTo="@id/navigation_register"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_otp_to_home"
            app:destination="@id/navigation_home"
            app:popUpTo="@id/navigation_register"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_book"
        android:name="org.filtersaathi.app.ui.book.BookFragment"
        android:label="@string/ui_nav_book">
        <action
            android:id="@+id/action_book_to_register"
            app:destination="@id/navigation_register" />
        <action
            android:id="@+id/action_book_to_track"
            app:destination="@id/navigation_track"
            app:popUpTo="@id/navigation_book"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_track"
        android:name="org.filtersaathi.app.ui.track.TrackFragment"
        android:label="@string/ui_track_title">
        <action
            android:id="@+id/action_track_to_book"
            app:destination="@id/navigation_book"
            app:popUpTo="@id/navigation_track"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_test_strip"
        android:name="org.filtersaathi.app.ui.placeholder.TestStripPlaceholderFragment"
        android:label="@string/ui_nav_scan" />

    <fragment
        android:id="@+id/navigation_water_check"
        android:name="org.filtersaathi.app.ui.placeholder.WaterCheckPlaceholderFragment"
        android:label="@string/ui_nav_public" />

    <fragment
        android:id="@+id/navigation_report"
        android:name="org.filtersaathi.app.ui.placeholder.ReportPlaceholderFragment"
        android:label="@string/ui_nav_report" />
</navigation>
